# Bursar 2.0 Environment Configuration
# Copy this file to '.env' and fill in your real Safaricom Daraja API credentials.

# M-Pesa client execution environment mode: sandbox or live
MPESA_MODE=sandbox

# Safaricom Daraja API Credentials
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=600298
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_initiator_password_here

# Public HTTPS endpoints (HTTPS required by Safaricom Daraja callbacks)
MPESA_B2C_RESULT_URL=https://your-domain.com/api/callbacks/b2c-result
MPESA_B2C_TIMEOUT_URL=https://your-domain.com/api/callbacks/b2c-timeout

# Lipa Na M-Pesa Online (STK Push) Settings
MPESA_LNM_SHORTCODE=174379
MPESA_LNM_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_STK_CALLBACK_URL=https://your-domain.com/api/callbacks/stk-callback
