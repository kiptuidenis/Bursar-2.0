# Primary Application Session Secret Key (REQUIRED)
# Generate a random 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: Comma-separated list of previous secret keys for zero-downtime key rotation
OLD_SECRET_KEYS=

# Allowed CORS Origins (Comma-separated list of scheme://domain[:port], no trailing slashes)
# Required in production. Defaults to localhost origins in development.
# Example: ALLOWED_ORIGINS=https://bursar.co.ke,https://app.bursar.co.ke
ALLOWED_ORIGINS=

# Active Database URL File (default: bursar.db)
DATABASE_URL=bursar.db



# Disable scheduler during startup if set to 1
DISABLE_SCHEDULER=0

# Payment Gateway Routing (Default to intasend)
PAYMENT_PROVIDER=intasend

# IntaSend Configuration
# Mode: simulation, sandbox, or live
INTASEND_MODE=simulation
INTASEND_SECRET_KEY=ISSecretKey_test_your_secret_key_here
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_your_publishable_key_here

# Optional: Shared secret challenge token defined in IntaSend Webhook configuration to secure callbacks
INTASEND_WEBHOOK_CHALLENGE=

# Google reCAPTCHA Configuration (Standard Free Tier)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_SCORE_THRESHOLD=0.5

